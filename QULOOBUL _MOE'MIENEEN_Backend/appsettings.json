{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=QuloobulMoeMieneen;Trusted_Connection=True;MultipleActiveResultSets=true",
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "Jwt": {
    "Issuer": "quloobul-moemieneen",
    "Audience": "quloobul-moemieneen-clients",
    "LifetimeMinutes": 60
  },
  // SD-04's upload guard. Override either value per environment without a code change.
  "Files": {
    "MaxBytes": 26214400
  },
  // Email:ConnectionString (Azure Communication Services, from Key Vault) and Email:From are set by
  // infra/main.bicep; with no connection string, notifications stay in-app only and nothing fails.
  // The web client's origin: activation and password-reset emails link to {BaseUrl}/set-password.
  "App": {
    "BaseUrl": ""
  }
}
