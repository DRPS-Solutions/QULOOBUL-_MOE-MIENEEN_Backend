@using MudBlazor
@inject AppDataService AppData
@inject ISnackbar Snackbar

@* Shown by MainLayout in place of the app while the account still has the temporary password an
   admin issued; the API refuses every other call until it is changed. *@

<MudText Typo="Typo.body2" Class="mb-3">
    You signed in with a temporary password. Choose your own to continue: at least 8 characters, with a letter and a digit.
</MudText>

<MudTextField T="string" @bind-Value="current" Label="Temporary Password" InputType="@(showCurrent ? InputType.Text : InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@Icon(showCurrent)" OnAdornmentClick="() => showCurrent = !showCurrent" AdornmentAriaLabel="@(showCurrent ? "Hide password" : "Show password")"
              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="128" Immediate="true" Class="mb-3" />
<MudTextField T="string" @bind-Value="password" Label="New Password" InputType="@(showNew ? InputType.Text : InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@Icon(showNew)" OnAdornmentClick="() => showNew = !showNew" AdornmentAriaLabel="@(showNew ? "Hide password" : "Show password")"
              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="128" Immediate="true"
              Validation="@(new Func<string, string?>(PasswordError))" Class="mb-3" />
<MudTextField T="string" @bind-Value="confirm" Label="Confirm Password" InputType="@(showConfirm ? InputType.Text : InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@Icon(showConfirm)" OnAdornmentClick="() => showConfirm = !showConfirm" AdornmentAriaLabel="@(showConfirm ? "Hide password" : "Show password")"
              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="128" Immediate="true"
              Validation="@(new Func<string, string?>(ConfirmError))" />

<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
           Disabled="@(!CanSubmit)" OnClick="Submit">
    @(saving ? "Saving..." : "Change Password")
</MudButton>
<MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" OnClick="AppData.LogoutAsync">Sign out</MudButton>

@code {
    private string current = "", password = "", confirm = "";
    private bool saving;
    private bool showCurrent, showNew, showConfirm; // each field has its own toggle
    private static string Icon(bool shown) => shown ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    // Same policy as SetPassword.razor / AuthService.EnsurePolicy.
    private static string? PasswordError(string p) =>
        p.Length < 8 || !p.Any(char.IsLetter) || !p.Any(char.IsDigit)
            ? "At least 8 characters, with a letter and a digit." : null;

    private string? ConfirmError(string c) => c != password ? "Passwords do not match." : null;

    private bool CanSubmit => !saving && current.Length > 0 && PasswordError(password) is null && confirm == password;

    private async Task Submit()
    {
        saving = true;
        var ok = await AppData.ChangePasswordAsync(current, password);
        saving = false;
        if (ok) Snackbar.Add("Password changed.", Severity.Success); // AppData showed any error
    }
}
