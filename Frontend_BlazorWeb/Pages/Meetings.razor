@page "/meetings"
@using MudBlazor
@inject AppDataService AppData
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Meeting Minutes</PageTitle>

<style>
    .drps-meeting {
        --drps-navy-900: #12271F;
        --drps-navy-800: #1C3D32;
        --drps-blue-600: #2F5C4C;
        --drps-blue-500: #3C7A63;
        --drps-blue-400: #6FA98C;
        --drps-bg: #F5F3EC;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #75806F;
        --drps-tint-blue: #EAF2ED;
        --drps-tint-amber: #F6EBD3;
        --drps-border-soft: #E7E4D8;
        --drps-outline: #DAD3BE;
        --drps-empty: #B7B2A0;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .drps-meeting-header {
        background: linear-gradient(135deg, var(--drps-navy-900) 0%, var(--drps-blue-600) 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .drps-meeting-title-field .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.35) !important;
    }

    .drps-meeting-title-field .mud-input-slot,
    .drps-meeting-title-field input {
        color: white !important;
    }

    .drps-meeting-title-field .mud-input-label {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .drps-header-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        height: 100%;
    }

    /* Meeting list rows open the minutes view on click. */
    .drps-meeting-row {
        cursor: pointer;
    }

    .drps-card-title {
        font-weight: 600;
        color: var(--drps-navy-800);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .drps-note-add-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
    }

    .drps-note-type-toggle {
        display: flex;
        gap: 6px;
        margin-bottom: 10px;
    }

    .drps-note-type-btn {
        border: 1px solid var(--drps-outline);
        background: var(--drps-surface);
        color: var(--drps-text-muted);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.72rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .drps-note-type-btn.selected {
        background: var(--drps-blue-500);
        border-color: var(--drps-blue-500);
        color: white;
    }

    .drps-note-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 420px;
        overflow-y: auto;
    }

    .drps-note-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        border-left: 3px solid var(--drps-blue-500);
        background: var(--drps-tint-blue);
    }

    .drps-note-item.action {
        border-left-color: #B9862E;
        background: var(--drps-tint-amber);
    }

    .drps-note-item-text {
        font-size: 0.83rem;
        color: var(--drps-navy-800);
    }

    .drps-note-item-meta {
        font-size: 0.68rem;
        color: var(--drps-text-muted);
        margin-top: 2px;
    }

    .drps-note-empty {
        color: var(--drps-empty);
        font-size: 0.8rem;
        text-align: center;
        padding: 24px 0;
    }

    /* --- Dark mode overrides, applied when MainLayout's toggle sets
       .dark-mode on the outer .page element --- */
    .page.dark-mode .drps-meeting {
        --drps-bg: #0B1B21;
        --drps-surface: #1E362B;
        --drps-text-muted: #93A69A;
        --drps-navy-800: #E9F0EA;
        --drps-tint-blue: rgba(60, 122, 99, 0.16);
        --drps-tint-amber: rgba(185, 134, 46, 0.18);
        --drps-border-soft: #2E4A3B;
        --drps-outline: #2C4436;
        --drps-empty: #4E5F52;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-meeting">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">

        @if (active is null)
        {
            @* --- MEETINGS LIST VIEW --- *@
            <div class="drps-meeting-header">
                <MudText Typo="Typo.h6" Style="font-weight:600;">Meeting Minutes</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartNewMeeting">
                    New Meeting
                </MudButton>
            </div>

            @* UC-03: search every set of minutes this user can see, by keyword and/or date. *@
            <div class="drps-card mb-4">
                <div class="d-flex gap-3 flex-wrap align-center">
                    <MudTextField T="string" @bind-Value="searchText" Label="Search minutes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="min-width:220px;" />
                    <div style="flex:1 1 130px; max-width:160px;"><MudDatePicker @bind-Date="searchFrom" Label="From" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></div>
                    <div style="flex:1 1 130px; max-width:160px;"><MudDatePicker @bind-Date="searchTo" Label="To" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" /></div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Search">Search</MudButton>
                    @if (searchResults is not null)
                    {
                        <MudButton Variant="Variant.Text" OnClick="@(() => searchResults = null)">Clear</MudButton>
                    }
                </div>
                @if (searchResults is not null)
                {
                    <div class="mt-3">
                        @if (!searchResults.Any())
                        {
                            <MudText Typo="Typo.body2">No minutes match.</MudText>
                        }
                        @foreach (var hit in searchResults)
                        {
                            var meeting = meetings.FirstOrDefault(m => m.MeetingId == hit.MeetingId);
                            <div class="drps-note-item" style="cursor:pointer;" @onclick="@(() => { if (meeting is not null) OpenExistingMeeting(meeting); })">
                                <div>
                                    <div class="drps-note-item-text"><b>@(meeting?.Title ?? $"Meeting #{hit.MeetingId}")</b></div>
                                    <div class="drps-note-item-meta">
                                        @AppDataService.Local(hit.TimeRecorded).ToString("dd MMM yyyy") · @Snippet(hit.MinutesText)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="drps-card">
                <MudTable T="MeetingDto" Items="meetings" Hover="true" Striped="false" Elevation="0" Loading="loading"
                          RowClass="drps-meeting-row" OnRowClick="@((TableRowClickEventArgs<MeetingDto> e) => { if (e.Item is not null) OpenExistingMeeting(e.Item); })">
                    <HeaderContent>
                        <MudTh>Topic / Title</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Organizer</MudTh>
                        <MudTh>Minutes</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Topic"><b>@context.Title</b></MudTd>
                        <MudTd DataLabel="Date">@context.MeetingDate.ToString("dd MMM yyyy")</MudTd>
                        <MudTd DataLabel="Organizer">@AppData.UserName(context.OrganiserId)</MudTd>
                        <MudTd DataLabel="Minutes">@(context.Minutes is null ? "Not recorded" : context.Minutes.ApprovedBy is null ? "Awaiting approval" : "Approved")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2">No meetings recorded yet.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </div>
        }
        else
        {
            @* --- MINUTES SCREEN: a new meeting, or one opened from the list --- *@
            <div class="drps-meeting-header">
                <div class="d-flex align-center gap-3">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="BackToList" />
                    @* A meeting's title is fixed once it exists (the API has no rename). *@
                    <MudTextField T="string"
                                  @bind-Value="active.Title"
                                  Placeholder="Untitled meeting"
                                  Variant="Variant.Outlined"
                                  Class="drps-meeting-title-field"
                                  Style="max-width:320px;"
                                  MaxLength="200"
                                  ReadOnly="@(active.MeetingId is not null)"
                                  Label="Meeting title" />
                </div>

                <div class="drps-header-actions">
                    @if (active.Minutes is { ApprovedBy: { } approver })
                    {
                        <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.Verified">Approved by @AppData.UserName(approver)</MudChip>
                    }
                    else if (CanApprove)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Verified" OnClick="Approve">
                            Approve minutes
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="DownloadDocx">
                        Download .docx
                    </MudButton>
                    @if (ViewOnly)
                    {
                        <MudChip T="string" Color="Color.Default" Icon="@Icons.Material.Filled.Visibility">View only</MudChip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   Disabled="@(!CanSave)"
                                   OnClick="SaveMeeting">
                            @(saving ? "Saving..." : active.MeetingId is null ? "Finish Meeting" : "Save Minutes")
                        </MudButton>
                    }
                </div>
            </div>

            <MudGrid>
                <MudItem xs="12" md="7">
                    <div class="drps-card">
                        <div class="drps-card-title">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                            Meeting Minutes
                            <MudButton Variant="@(recording ? Variant.Filled : Variant.Outlined)"
                                       Disabled="@ViewOnly"
                                       Color="@(recording ? Color.Error : Color.Primary)"
                                       Size="Size.Small"
                                       Class="ml-auto"
                                       StartIcon="@(recording ? Icons.Material.Filled.Stop : Icons.Material.Filled.Mic)"
                                       OnClick="ToggleRecording">
                                @(recording ? "Stop recording" : "Record")
                            </MudButton>
                        </div>
                        <MudTextField T="string"
                                      @bind-Value="active.MinutesText"
                                      Placeholder="Type meeting minutes here as the discussion happens..."
                                      Variant="Variant.Outlined"
                                      Lines="16"
                                      ReadOnly="@ViewOnly"
                                      FullWidth="true" />
                    </div>
                </MudItem>

                @if (!ViewOnly)
                {
                <MudItem xs="12" md="5">
                    <div class="drps-card">
                        <div class="drps-card-title">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" />
                            Notes &amp; Action Items
                        </div>

                        <div class="drps-note-type-toggle">
                            <span class="drps-note-type-btn @(!addingActionItem ? "selected" : "")" @onclick="() => addingActionItem = false">Note</span>
                            <span class="drps-note-type-btn @(addingActionItem ? "selected" : "")" @onclick="() => addingActionItem = true">Action Item</span>
                        </div>

                        <div class="drps-note-add-row">
                            <MudTextField T="string"
                                          @bind-Value="noteInput"
                                          Placeholder="Add a note or action item..."
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          Immediate="true"
                                          OnKeyUp="HandleNoteKeyUp" />
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           OnClick="AddNote" />
                        </div>

                        <div class="drps-note-list">
                            @if (!notes.Any())
                            {
                                <div class="drps-note-empty">Nothing captured yet - notes are added to the minutes when you save.</div>
                            }
                            else
                            {
                                @foreach (var note in notes)
                                {
                                    <div class="drps-note-item @(note.IsActionItem ? "action" : "")">
                                        <div>
                                            <div class="drps-note-item-text">@note.Text</div>
                                            <div class="drps-note-item-meta">@(note.IsActionItem ? "Action item" : "Note")</div>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="() => notes.Remove(note)" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </MudItem>
                }
            </MudGrid>
        }

    </MudContainer>
</div>

@code {
    private IReadOnlyList<MeetingDto> meetings = [];
    private bool loading = true;

    // The meeting open on the minutes screen; null shows the list.
    private MeetingForm? active;
    private string originalMinutes = string.Empty;
    private readonly List<MeetingNote> notes = [];
    private string noteInput = string.Empty;
    private bool addingActionItem = false;
    private bool saving;

    // Dictation: the browser transcribes speech and each finished phrase is
    // appended to the minutes text.
    // Reference: Microsoft, "Call .NET methods from JavaScript functions in ASP.NET Core Blazor." Accessed: Oct. 04, 2026. [Online]. Available: https://learn.microsoft.com/en-us/aspnet/core/blazor/javascript-interoperability/call-dotnet-from-javascript
    private bool recording;
    private DotNetObjectReference<Meetings>? self;

    private async Task ToggleRecording()
    {
        if (recording) { await JS.InvokeVoidAsync("dictation.stop"); return; }
        self ??= DotNetObjectReference.Create(this);
        recording = await JS.InvokeAsync<bool>("dictation.start", self);
        if (!recording) Snackbar.Add("Speech recognition isn't supported in this browser. Try Chrome or Edge.", Severity.Warning);
    }

    [JSInvokable]
    public void OnSpeech(string text)
    {
        if (active is null || text.Length == 0) return;
        active.MinutesText = active.MinutesText.Length == 0 ? text : active.MinutesText.TrimEnd() + " " + text;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDictationEnded() { recording = false; StateHasChanged(); }

    public void Dispose()
    {
        if (recording) _ = JS.InvokeVoidAsync("dictation.stop");
        self?.Dispose();
    }

    // A new meeting can always be finished; an existing one only once its
    // minutes have changed.
    private bool CanSave => active is not null && !saving &&
        (active.MeetingId is null || (ComposedMinutes() is { Length: > 0 } minutes && minutes != originalMinutes));

    protected override Task OnInitializedAsync() => LoadMeetings();

    private async Task LoadMeetings()
    {
        loading = true;
        meetings = await AppData.GetAsync<List<MeetingDto>>("api/meetings") ?? [];
        loading = false;
    }

    private void StartNewMeeting() => Open(new MeetingForm());

    // UC-03 alternate flow: reopen a saved meeting to edit or append to
    // its minutes. Saving records a new minutes entry; the list shows the
    // latest.
    private void OpenExistingMeeting(MeetingDto meeting) => Open(new MeetingForm
    {
        MeetingId = meeting.MeetingId,
        Title = meeting.Title,
        MinutesText = meeting.Minutes?.MinutesText ?? string.Empty,
        MeetingDate = meeting.MeetingDate,
        OrganiserId = meeting.OrganiserId,
        AttendeeIds = meeting.AttendeeIds,
        Minutes = meeting.Minutes,
    });

    // ViewAllMeetings (Secondary Admin) lists every meeting, but only the organiser, an attendee or an
    // admin may record minutes on one (the API's rule), so anyone else gets a read-only view (M5).
    private bool ViewOnly => active is { MeetingId: not null } m
        && m.OrganiserId != AppData.CurrentUser?.UserId
        && !m.AttendeeIds.Contains(AppData.CurrentUser?.UserId ?? 0)
        && !AppData.HasPermission(Permissions.ManageUsers);

    // The minutes as on screen (unsaved notes included) in a new Word document:
    // a minimal .docx is just three XML parts in a zip.
    // Reference: Ecma International, "Office Open XML File Formats," ECMA-376, 5th ed., Dec. 2021. Accessed: Oct. 04, 2026. [Online]. Available: https://ecma-international.org/publications-and-standards/standards/ecma-376/
    private string DocxHref()
    {
        static string Para(string text, bool heading = false) =>
            $"<w:p><w:r>{(heading ? "<w:rPr><w:b/><w:sz w:val=\"32\"/></w:rPr>" : "")}" +
            $"<w:t xml:space=\"preserve\">{System.Security.SecurityElement.Escape(text)}</w:t></w:r></w:p>";

        var title = string.IsNullOrWhiteSpace(active!.Title) ? "Untitled meeting" : active.Title.Trim();
        var body = Para(title, heading: true) + Para(active.MeetingDate.ToString("dd MMM yyyy")) + Para("")
            + string.Concat(ComposedMinutes().Split('\n').Select(line => Para(line.TrimEnd('\r'))));

        using var stream = new MemoryStream();
        using (var zip = new System.IO.Compression.ZipArchive(stream, System.IO.Compression.ZipArchiveMode.Create))
        {
            void Add(string path, string xml)
            {
                using var w = new StreamWriter(zip.CreateEntry(path).Open());
                w.Write("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" + xml);
            }
            Add("[Content_Types].xml", "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">" +
                "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>" +
                "<Default Extension=\"xml\" ContentType=\"application/xml\"/>" +
                "<Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/></Types>");
            Add("_rels/.rels", "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
                "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/></Relationships>");
            Add("word/document.xml", "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
                $"<w:body>{body}</w:body></w:document>");
        }
        return "data:application/vnd.openxmlformats-officedocument.wordprocessingml.document;base64," + Convert.ToBase64String(stream.ToArray());
    }

    // Built on click, not at render, so a failure is reported instead of crashing the page; clicking again retries.
    private async Task DownloadDocx()
    {
        try
        {
            await JS.InvokeVoidAsync("downloadFile", DocxName(), DocxHref());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Snackbar.Add("Couldn't create the Word document. Please try again.", Severity.Error);
        }
    }

    private string DocxName() =>
        string.Concat((string.IsNullOrWhiteSpace(active!.Title) ? "meeting-minutes" : active.Title.Trim())
            .Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c)) + ".docx";

    // The API lets the organiser or an admin sign off the saved minutes, and only unchanged ones.
    private bool CanApprove => active?.Minutes is not null && active.MinutesText == originalMinutes
        && (active.OrganiserId == AppData.CurrentUser?.UserId || AppData.HasPermission(Permissions.ManageUsers));

    private async Task Approve()
    {
        if (await AppData.SendAsync<MeetingMinutesDto>(HttpMethod.Post, $"api/meetings/minutes/{active!.Minutes!.MinutesId}/approve", new { }) is { } approved)
        {
            active.Minutes = approved;
            await LoadMeetings();
        }
    }

    private string searchText = string.Empty;
    private DateTime? searchFrom, searchTo;
    private List<MeetingMinutesDto>? searchResults;

    private async Task Search()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchText)) query.Add($"q={Uri.EscapeDataString(searchText.Trim())}");
        if (searchFrom is { } f) query.Add($"from={f:yyyy-MM-dd}");
        if (searchTo is { } t) query.Add($"to={t.AddDays(1):yyyy-MM-dd}");
        searchResults = await AppData.GetAsync<List<MeetingMinutesDto>>("api/meetings/minutes?" + string.Join("&", query)) ?? [];
    }

    private static string Snippet(string text) => text.Length <= 120 ? text : text[..120] + "…";

    private void Open(MeetingForm meeting)
    {
        active = meeting;
        originalMinutes = meeting.MinutesText;
        notes.Clear();
        noteInput = string.Empty;
        addingActionItem = false;
    }

    // Leaves without saving.
    private async Task BackToList()
    {
        if (recording) await JS.InvokeVoidAsync("dictation.stop");
        active = null;
    }

    private void AddNote()
    {
        if (string.IsNullOrWhiteSpace(noteInput)) return;
        notes.Add(new MeetingNote(noteInput.Trim(), addingActionItem));
        noteInput = string.Empty;
    }

    private void HandleNoteKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddNote();
    }

    // The ERD keeps minutes as one text per record, so notes and action
    // items are appended to it when saved.
    private string ComposedMinutes() => string.Join("\n\n", new[]
    {
        active!.MinutesText.Trim(),
        Section("Notes", notes.Where(n => !n.IsActionItem)),
        Section("Action items", notes.Where(n => n.IsActionItem)),
    }.Where(s => s.Length > 0));

    private static string Section(string heading, IEnumerable<MeetingNote> items) =>
        items.Any() ? $"{heading}:\n" + string.Join("\n", items.Select(n => $"- {n.Text}")) : "";

    // "Finish Meeting" creates the meeting (the API sets the signed-in user
    // as organiser), then records its minutes if there are any. "Save
    // Minutes" records a new minutes entry for an existing meeting.
    private async Task SaveMeeting()
    {
        if (!CanSave) return;
        var meeting = active!;
        var minutes = ComposedMinutes();
        saving = true;

        if (meeting.MeetingId is null)
        {
            // Remember the id straight away, so a retry after a failed
            // minutes save doesn't create the meeting twice.
            meeting.MeetingId = await AppData.SendAsync<int?>(HttpMethod.Post, "api/meetings", new CreateMeetingRequest
            {
                Title = string.IsNullOrWhiteSpace(meeting.Title) ? "Untitled meeting" : meeting.Title.Trim(),
                MeetingDate = AppDataService.Wall(DateTime.Now),
            });
        }

        var saved = meeting.MeetingId is not null && (minutes.Length == 0 ||
            await AppData.SendAsync(HttpMethod.Post, $"api/meetings/{meeting.MeetingId}/minutes",
                new RecordMinutesRequest { MinutesText = minutes }));
        saving = false;

        if (saved)
        {
            active = null;
            await LoadMeetings();
        }
    }

    private record MeetingNote(string Text, bool IsActionItem);

    private class MeetingForm
    {
        public int? MeetingId { get; set; } // null until the meeting exists
        public string Title { get; set; } = string.Empty;
        public string MinutesText { get; set; } = string.Empty;
        public DateTime MeetingDate { get; init; } = DateTime.Now;
        public int? OrganiserId { get; init; }
        public IReadOnlyList<int> AttendeeIds { get; init; } = [];
        public MeetingMinutesDto? Minutes { get; set; }  // the saved version, for approval
    }
}
