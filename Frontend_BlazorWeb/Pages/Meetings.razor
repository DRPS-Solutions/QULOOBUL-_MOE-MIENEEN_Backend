@page "/meetings"
@using MudBlazor
@implements IDisposable
@inject AppDataService AppData

<PageTitle>Meeting Minutes</PageTitle>

<style>
    .drps-meeting {
        --drps-navy-900: #12271F;
        --drps-navy-800: #1C3D32;
        --drps-blue-600: #2F5C4C;
        --drps-blue-500: #3C7A63;
        --drps-blue-400: #6FA98C;
        --drps-bg: #F5F3EC;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #75806F;
        --drps-tint-blue: #EAF2ED;
        --drps-tint-amber: #F6EBD3;
        --drps-panel-bg: #F3F0E5;
        --drps-border-soft: #E7E4D8;
        --drps-outline: #DAD3BE;
        --drps-empty: #B7B2A0;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .drps-meeting-header {
        background: linear-gradient(135deg, var(--drps-navy-900) 0%, var(--drps-blue-600) 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .drps-meeting-title-field .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.35) !important;
    }

    .drps-meeting-title-field .mud-input-slot,
    .drps-meeting-title-field input {
        color: white !important;
    }

    .drps-meeting-title-field .mud-input-label {
        color: rgba(255, 255, 255, 0.7) !important;
    }

    .drps-record-controls {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }

    .drps-record-status {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.85);
        font-variant-numeric: tabular-nums;
    }

    .drps-record-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #E0435C;
    }

    .drps-record-dot.live {
        animation: drps-pulse 1.4s ease-in-out infinite;
    }

    @@keyframes drps-pulse {
        0% { box-shadow: 0 0 0 0 rgba(224, 67, 92, 0.6); }
        70% { box-shadow: 0 0 0 8px rgba(224, 67, 92, 0); }
        100% { box-shadow: 0 0 0 0 rgba(224, 67, 92, 0); }
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 2px 10px var(--drps-shadow);
        height: 100%;
    }

    /* Meeting list rows open the details/playback view on click. */
    .drps-meeting-row {
        cursor: pointer;
    }

    .drps-playback-card {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
    }

    .drps-playback-time {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.85);
        font-variant-numeric: tabular-nums;
        min-width: 92px;
    }

    .drps-playback-slider {
        width: 160px;
    }

    .drps-playback-hint {
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.65);
    }

    .drps-card-title {
        font-weight: 600;
        color: var(--drps-navy-800);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .drps-note-add-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
    }

    .drps-note-type-toggle {
        display: flex;
        gap: 6px;
        margin-bottom: 10px;
    }

    .drps-note-type-btn {
        border: 1px solid var(--drps-outline);
        background: var(--drps-surface);
        color: var(--drps-text-muted);
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.72rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .drps-note-type-btn.selected {
        background: var(--drps-blue-500);
        border-color: var(--drps-blue-500);
        color: white;
    }

    .drps-note-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 420px;
        overflow-y: auto;
    }

    .drps-note-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        border-left: 3px solid var(--drps-blue-500);
        background: var(--drps-tint-blue);
    }

    .drps-note-item.action {
        border-left-color: #B9862E;
        background: var(--drps-tint-amber);
    }

    .drps-note-item-text {
        font-size: 0.83rem;
        color: var(--drps-navy-800);
    }

    .drps-note-item-meta {
        font-size: 0.68rem;
        color: var(--drps-text-muted);
        margin-top: 2px;
    }

    .drps-note-empty {
        color: var(--drps-empty);
        font-size: 0.8rem;
        text-align: center;
        padding: 24px 0;
    }

    .drps-transcript-card {
        margin-top: 20px;
    }

    .drps-transcript-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .drps-transcript-hint {
        font-size: 0.78rem;
        color: var(--drps-text-muted);
    }

    .drps-transcript-box {
        background: var(--drps-panel-bg);
        border: 1px solid var(--drps-border-soft);
        border-radius: 10px;
        padding: 16px;
        font-size: 0.85rem;
        color: var(--drps-navy-800);
        line-height: 1.6;
        white-space: pre-wrap;
    }

    /* --- Dark mode overrides, applied when MainLayout's toggle sets
       .dark-mode on the outer .page element --- */
    .page.dark-mode .drps-meeting {
        --drps-bg: #0B1B21;
        --drps-surface: #1E362B;
        --drps-text-muted: #93A69A;
        --drps-navy-800: #E9F0EA;
        --drps-tint-blue: rgba(60, 122, 99, 0.16);
        --drps-tint-amber: rgba(185, 134, 46, 0.18);
        --drps-panel-bg: #0F211A;
        --drps-border-soft: #2E4A3B;
        --drps-outline: #2C4436;
        --drps-empty: #4E5F52;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-meeting">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6">

        @if (!showCreateScreen)
        {
            @* --- MAIN MEETINGS LIST VIEW --- *@
            <div class="drps-meeting-header">
                <MudText Typo="Typo.h6" Style="font-weight:600;">Meeting Minutes &amp; Recordings</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartNewMeeting">
                    New / Active Meeting
                </MudButton>
            </div>

            <div class="drps-card">
                <MudTable T="Meeting" Items="AppData.Meetings" Hover="true" Striped="false" Elevation="0"
                          RowClass="drps-meeting-row" OnRowClick="@((TableRowClickEventArgs<Meeting> e) => OpenExistingMeeting(e.Item))">
                    <HeaderContent>
                        <MudTh>Topic / Title</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Duration</MudTh>
                        <MudTh>Organizer</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Topic"><b>@context.Title</b></MudTd>
                        <MudTd DataLabel="Date">@context.Date.ToString("dd MMM yyyy")</MudTd>
                        <MudTd DataLabel="Duration">@context.Duration</MudTd>
                        <MudTd DataLabel="Organizer">@context.Organizer</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }
        else
        {
            @* --- YOUR ORIGINAL MEETING MINUTES & RECORDING SCREEN --- *@
            <div class="drps-meeting-header">
                <div class="d-flex align-center gap-3">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Surface" OnClick="BackToList" />
                    <MudTextField T="string"
                                  @bind-Value="activeMeeting!.Title"
                                  Placeholder="Untitled meeting"
                                  Variant="Variant.Outlined"
                                  Class="drps-meeting-title-field"
                                  Style="max-width:320px;"
                                  Label="Meeting title" />
                </div>

                <div class="drps-record-controls">
                    @if (!isViewingExisting)
                    {
                        <div class="drps-record-status">
                            <span class="drps-record-dot @(isRecording ? "live" : "")"></span>
                            @(isRecording ? "Recording" : hasRecorded ? "Stopped" : "Not started") &middot; @FormattedElapsed
                        </div>

                        @if (!isRecording)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.FiberManualRecord"
                                       OnClick="StartRecording">
                                @(hasRecorded ? "Resume Recording" : "Start Recording")
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       OnClick="StopRecording">
                                Stop Recording
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   Disabled="@isRecording"
                                   OnClick="CreateMeeting">
                            Finish Meeting
                        </MudButton>
                    }
                    else
                    {
                        @* --- Placeholder audio playback for a past meeting. No
                           actual audio is stored in this prototype, so play just
                           advances a fake position marker up to the meeting's
                           recorded duration. --- *@
                        <div class="drps-playback-card">
                            <MudIconButton Icon="@(isPlaying ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                                           Color="Color.Surface"
                                           Variant="Variant.Filled"
                                           Disabled="@(playbackTotalSeconds <= 0)"
                                           OnClick="TogglePlayback" />
                            <MudSlider T="int"
                                       Class="drps-playback-slider"
                                       Min="0"
                                       Max="@Math.Max(playbackTotalSeconds, 1)"
                                       Value="playbackSeconds"
                                       ValueChanged="OnScrubPlayback"
                                       Color="Color.Primary" />
                            <span class="drps-playback-time">@FormattedPlaybackPosition / @FormattedPlaybackTotal</span>
                        </div>
                        <MudButton Variant="Variant.Filled" Color="Color.Surface" OnClick="BackToList">
                            Close
                        </MudButton>
                    }
                </div>
            </div>

            @if (isViewingExisting)
            {
                <div class="drps-playback-hint" style="margin:-14px 0 20px 4px;">
                    Placeholder playback - audio isn't actually recorded/stored in this prototype.
                </div>
            }

            <MudGrid>
                <MudItem xs="12" md="7">
                    <div class="drps-card">
                        <div class="drps-card-title">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                            Meeting Minutes
                        </div>
                        <MudTextField T="string"
                                      @bind-Value="activeMeeting!.MinutesText"
                                      Placeholder="Type meeting minutes here as the discussion happens..."
                                      Variant="Variant.Outlined"
                                      Lines="16"
                                      FullWidth="true" />
                    </div>
                </MudItem>

                <MudItem xs="12" md="5">
                    <div class="drps-card">
                        <div class="drps-card-title">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" />
                            Notes &amp; Action Items
                        </div>

                        <div class="drps-note-type-toggle">
                            <span class="drps-note-type-btn @(!addingActionItem ? "selected" : "")" @onclick="() => addingActionItem = false">Note</span>
                            <span class="drps-note-type-btn @(addingActionItem ? "selected" : "")" @onclick="() => addingActionItem = true">Action Item</span>
                        </div>

                        <div class="drps-note-add-row">
                            <MudTextField T="string"
                                          @bind-Value="noteInput"
                                          Placeholder="Add a note or action item..."
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          OnKeyUp="HandleNoteKeyUp" />
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           OnClick="AddNote" />
                        </div>

                        <div class="drps-note-list">
                            @if (!activeMeeting!.Notes.Any())
                            {
                                <div class="drps-note-empty">Nothing captured yet</div>
                            }
                            else
                            {
                                @foreach (var note in activeMeeting!.Notes)
                                {
                                    <div class="drps-note-item @(note.IsActionItem ? "action" : "")">
                                        <div>
                                            <div class="drps-note-item-text">@note.Text</div>
                                            <div class="drps-note-item-meta">@(note.IsActionItem ? "Action item" : "Note") &middot; @note.Timestamp</div>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="() => activeMeeting!.Notes.Remove(note)" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </MudItem>
            </MudGrid>

            <div class="drps-card drps-transcript-card">
                <div class="drps-card-title">
                    <MudIcon Icon="@Icons.Material.Filled.Subtitles" Size="Size.Small" />
                    Transcript
                </div>

                <div class="drps-transcript-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               Disabled="@(isRecording || !hasRecorded || isGeneratingTranscript)"
                               OnClick="GenerateTranscript">
                        Generate Transcript
                    </MudButton>

                    @if (isGeneratingTranscript)
                    {
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                        <span class="drps-transcript-hint">Generating...</span>
                    }
                    else if (!hasRecorded)
                    {
                        <span class="drps-transcript-hint">Record the meeting first to enable this</span>
                    }
                    else if (isRecording)
                    {
                        <span class="drps-transcript-hint">Stop recording to generate a transcript</span>
                    }
                </div>

                @if (transcriptReady)
                {
                    <div class="drps-transcript-box">@activeMeeting!.Transcript</div>
                }
            </div>
        }

    </MudContainer>
</div>

@code {
    // Cascaded (by name) from MainLayout - used to attribute a new
    // meeting to whoever is actually signed in, instead of the
    // hard-coded "Naledi Dube" this page used before.
    [CascadingParameter(Name = "CurrentUserName")]
    private string? CurrentUserName { get; set; }

    private bool showCreateScreen = false;

    // True when the create/active screen is showing a meeting the user
    // clicked on from the list (view/edit past minutes + placeholder
    // playback), as opposed to a brand new in-progress recording.
    private bool isViewingExisting = false;

    // The Meeting object being built while the create/active screen is
    // open. Title/minutes/notes bind directly onto it, and
    // GenerateTranscript writes straight into its Transcript property,
    // so nothing here is page-local scratch state that could be lost -
    // AppData.AddMeeting just adds this same instance once "Finish
    // Meeting" is clicked.
    private Meeting? activeMeeting;

    private bool isRecording = false;
    private bool hasRecorded = false;
    private int elapsedSeconds = 0;
    private System.Timers.Timer? recordingTimer;

    private string FormattedElapsed => TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss");

    private void StartRecording()
    {
        isRecording = true;
        hasRecorded = true;
        transcriptReady = false;

        recordingTimer = new System.Timers.Timer(1000);
        recordingTimer.Elapsed += (sender, args) =>
        {
            elapsedSeconds++;
            InvokeAsync(StateHasChanged);
        };
        recordingTimer.Start();
    }

    private void StopRecording()
    {
        isRecording = false;
        recordingTimer?.Stop();
        recordingTimer?.Dispose();
        recordingTimer = null;
    }

    // --- Placeholder audio playback (view-existing-meeting mode) ---
    // No real audio is stored anywhere in this prototype; playing just
    // advances a fake position marker at 1 second/second up to the
    // meeting's recorded Duration, so the UI reads and behaves like a
    // real player without needing an actual audio backend.
    private bool isPlaying = false;
    private int playbackSeconds = 0;
    private int playbackTotalSeconds = 0;
    private System.Timers.Timer? playbackTimer;

    private string FormattedPlaybackPosition => TimeSpan.FromSeconds(playbackSeconds).ToString(@"mm\:ss");
    private string FormattedPlaybackTotal => TimeSpan.FromSeconds(playbackTotalSeconds).ToString(@"mm\:ss");

    private void TogglePlayback()
    {
        if (isPlaying)
        {
            StopPlayback();
            return;
        }

        // Restart from the beginning once it's already played through.
        if (playbackSeconds >= playbackTotalSeconds)
        {
            playbackSeconds = 0;
        }

        isPlaying = true;
        playbackTimer = new System.Timers.Timer(1000);
        playbackTimer.Elapsed += (sender, args) =>
        {
            playbackSeconds++;
            if (playbackSeconds >= playbackTotalSeconds)
            {
                playbackSeconds = playbackTotalSeconds;
                StopPlayback();
            }
            InvokeAsync(StateHasChanged);
        };
        playbackTimer.Start();
    }

    // Stops the playback timer without resetting position, so pausing
    // and hitting play again resumes from where it left off.
    private void StopPlayback()
    {
        isPlaying = false;
        playbackTimer?.Stop();
        playbackTimer?.Dispose();
        playbackTimer = null;
    }

    // Dragging the slider manually jumps playback to that position.
    private void OnScrubPlayback(int value)
    {
        playbackSeconds = Math.Clamp(value, 0, Math.Max(playbackTotalSeconds, 0));
    }

    // Parses a Duration string into whole seconds. Handles both the
    // "mm:ss" format produced by FormattedElapsed for freshly-recorded
    // meetings, and the "N mins"/"N min" format used by seeded demo
    // data - falls back to 0 (playback disabled) if neither matches.
    private static int ParseDurationSeconds(string duration)
    {
        if (string.IsNullOrWhiteSpace(duration)) return 0;

        var colonParts = duration.Split(':');
        if (colonParts.Length == 2 &&
            int.TryParse(colonParts[0], out var minutes) &&
            int.TryParse(colonParts[1], out var seconds))
        {
            return minutes * 60 + seconds;
        }

        var digits = new string(duration.TakeWhile(c => char.IsDigit(c)).ToArray());
        if (int.TryParse(digits, out var minsOnly))
        {
            return minsOnly * 60;
        }

        return 0;
    }

    private string noteInput = string.Empty;
    private bool addingActionItem = false;

    private void AddNote()
    {
        if (string.IsNullOrWhiteSpace(noteInput) || activeMeeting is null) return;

        activeMeeting.Notes.Add(new MeetingNote
        {
            Text = noteInput.Trim(),
            IsActionItem = addingActionItem,
            Timestamp = isRecording ? FormattedElapsed : "Not recording"
        });
        noteInput = string.Empty;
    }

    private void HandleNoteKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddNote();
        }
    }

    private bool isGeneratingTranscript = false;
    private bool transcriptReady = false;

    private async Task GenerateTranscript()
    {
        if (activeMeeting is null) return;

        isGeneratingTranscript = true;
        StateHasChanged();

        await Task.Delay(1400);

        var title = string.IsNullOrWhiteSpace(activeMeeting.Title) ? "Untitled meeting" : activeMeeting.Title;

        // Written straight onto the Meeting object being edited (rather
        // than a page-local string) so it persists in AppData.Meetings
        // once "Finish Meeting" is clicked instead of being lost.
        activeMeeting.Transcript =
            $"Transcript for \"{title}\" ({FormattedElapsed} recorded)\n\n" +
            "[Speaker 1] Placeholder line of dialogue reconstructed from the recorded audio.\n" +
            "[Speaker 2] Placeholder response continuing the discussion.\n" +
            "[Speaker 1] Placeholder wrap-up remark closing out this section.\n\n" +
            "This is placeholder text standing in for real speech-to-text output, " +
            "to be replaced once a transcription service is integrated.";

        transcriptReady = true;
        isGeneratingTranscript = false;
    }

    // "New / Active Meeting" button - opens a blank working Meeting and
    // switches to the create/active screen.
    private void StartNewMeeting()
    {
        activeMeeting = new Meeting();
        showCreateScreen = true;
        isViewingExisting = false;
        ResetSessionState();
    }

    // Clicking a row in the meetings list - opens the same
    // create/active screen, but in "view existing" mode: editing
    // minutes/notes writes straight onto the real Meeting instance
    // already sitting in AppData.Meetings (no separate save step
    // needed), and the recording controls are swapped for a
    // placeholder playback bar.
    private void OpenExistingMeeting(Meeting meeting)
    {
        activeMeeting = meeting;
        showCreateScreen = true;
        isViewingExisting = true;
        ResetSessionState();

        hasRecorded = true;
        playbackTotalSeconds = ParseDurationSeconds(meeting.Duration);
        playbackSeconds = 0;
        isPlaying = false;
        transcriptReady = !string.IsNullOrWhiteSpace(meeting.Transcript);
    }

    private void CreateMeeting()
    {
        if (activeMeeting is null) return;

        if (isRecording)
        {
            StopRecording();
        }

        activeMeeting.Date = DateTime.Today;
        activeMeeting.Duration = FormattedElapsed;
        activeMeeting.Organizer = string.IsNullOrWhiteSpace(CurrentUserName) ? "Unknown" : CurrentUserName!;
        if (string.IsNullOrWhiteSpace(activeMeeting.Title))
        {
            activeMeeting.Title = "Untitled meeting";
        }

        AppData.AddMeeting(activeMeeting);

        activeMeeting = null;
        ResetSessionState();
        showCreateScreen = false;
    }

    private void BackToList()
    {
        // Cancels the in-progress meeting without saving it to the list
        // - but only when it's actually a new, not-yet-saved meeting.
        // A meeting opened from the list is already in AppData.Meetings
        // and was edited in place, so there's nothing to discard.
        if (isRecording)
        {
            StopRecording();
        }
        StopPlayback();

        activeMeeting = null;
        ResetSessionState();
        showCreateScreen = false;
        isViewingExisting = false;
    }

    // Resets only the recording/transcript/playback session state - the
    // meeting's own data (title, minutes, notes, transcript) lives on
    // activeMeeting itself and is reset simply by replacing it with a
    // new Meeting() (or left untouched, for an existing meeting).
    private void ResetSessionState()
    {
        noteInput = string.Empty;
        addingActionItem = false;

        hasRecorded = false;
        elapsedSeconds = 0;

        transcriptReady = false;
        isGeneratingTranscript = false;

        StopPlayback();
        playbackSeconds = 0;
        playbackTotalSeconds = 0;
    }

    // Re-render if meetings change elsewhere while this page is open.
    protected override void OnInitialized()
    {
        AppData.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppData.OnChange -= StateHasChanged;
        recordingTimer?.Stop();
        recordingTimer?.Dispose();
        playbackTimer?.Stop();
        playbackTimer?.Dispose();
    }
}