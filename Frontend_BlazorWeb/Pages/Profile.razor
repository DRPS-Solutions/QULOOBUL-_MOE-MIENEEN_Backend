@page "/profile"
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@inject AppDataService AppData
@inject ISnackbar Snackbar

<PageTitle>My Profile</PageTitle>

@* =====================================================================
   STYLE BLOCK
   Same DRPS palette-as-CSS-variables approach as Notifications.razor,
   scoped under .drps-profile so it doesn't leak into MudBlazor's theme.
   ===================================================================== *@
<style>
    .drps-profile {
        --drps-navy-900: #12271F;
        --drps-blue-600: #2F5C4C;
        --drps-bg: #F5F3EC;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #75806F;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .drps-profile-header {
        background: linear-gradient(135deg, var(--drps-navy-900) 0%, var(--drps-blue-600) 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
    }

    .drps-profile-header .drps-subtitle {
        color: rgba(255, 255, 255, 0.92);
        font-size: 0.85rem;
        margin-top: 4px;
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
    }

    .drps-profile-muted {
        color: var(--drps-text-muted);
        font-size: 0.85rem;
    }

    .page.dark-mode .drps-profile {
        --drps-bg: #0B1B21;
        --drps-surface: #1E362B;
        --drps-text-muted: #93A69A;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-profile">
    <MudContainer MaxWidth="MaxWidth.Small" Class="pt-6">

        <div class="drps-profile-header">
            <MudText Typo="Typo.h6" HtmlTag="h1" Style="font-weight:600;">My Profile</MudText>
            <div class="drps-subtitle">Update the details other staff see and contact you on.</div>
        </div>

        <div class="drps-card">
            @if (user is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudTextField T="string" @bind-Value="firstName" Label="First Name" Required="true" RequiredError="Enter a first name." Variant="Variant.Outlined" MaxLength="100" Immediate="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="surname" Label="Surname" Required="true" RequiredError="Enter a surname." Variant="Variant.Outlined" MaxLength="100" Immediate="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="cellNo" Label="Cell Number" Required="true" RequiredError="Enter a cell number." Validation="@PhoneRule" InputType="InputType.Telephone" Variant="Variant.Outlined" MaxLength="20" Immediate="true" Class="mb-3" />

                @* Email is also the sign-in name: after saving, the user signs in with the new address. *@
                <MudTextField T="string" @bind-Value="email" Label="Email Address" Required="true" RequiredError="Enter an email address." Validation="@EmailRule" InputType="InputType.Email" Variant="Variant.Outlined" MaxLength="256" Immediate="true" HelperText="You sign in with this address." Class="mb-3" />
                @* Role is an admin's call (SM-03), so it is read-only here. *@
                <MudTextField T="string" Value="@user.Role" Label="Role" Variant="Variant.Outlined" ReadOnly="true" Disabled="true" Class="mb-2" />
                <div class="drps-profile-muted mb-4">To change your role, ask an administrator.</div>

                <div class="d-flex gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(!CanSave)">
                        @(saving ? "Saving..." : "Save Changes")
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="Reset" Disabled="@(saving || !IsDirty)">Discard</MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lock" OnClick="SendPasswordLink" Disabled="@sendingLink">
                        @(sendingLink ? "Sending..." : "Update Password")
                    </MudButton>
                </div>
            }
        </div>

        @* UC-08 / test plan N4: per-type opt-out. A muted type sends neither in-app nor email;
           an admin's direct announcement ignores these, so it isn't listed. *@
        <div class="drps-card mt-4">
            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Notifications</MudText>
            <div class="drps-profile-muted mb-2">Choose what you hear about. Messages sent directly by an administrator always come through.</div>
            @if (prefs is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                @foreach (var pref in prefs.Where(p => p.CanMute))
                {
                    <MudSwitch T="bool" Value="pref.Enabled" ValueChanged="@(v => SetPref(pref, v))" Color="Color.Primary"
                               Label="@pref.Label" Disabled="@savingPref" />
                }
            }
        </div>
    </MudContainer>
</div>

@code {
    private UserDto? user;
    private string firstName = "", surname = "", cellNo = "", email = "";
    private bool saving, sendingLink;

    // The same rules UpdateUserRequest applies server-side, so the message shows before Save.
    private static readonly PhoneAttribute PhoneRule = new() { ErrorMessage = "Enter a valid phone number, e.g. 082 123 4567." };
    private static readonly EmailAddressAttribute EmailRule = new() { ErrorMessage = "Enter a valid email address." };

    private bool IsDirty =>
        user is not null && (firstName.Trim() != user.FirstName || surname.Trim() != user.Surname
            || cellNo.Trim() != user.CellNo || email.Trim() != user.Email);

    private bool CanSave =>
        !saving && IsDirty &&
        !string.IsNullOrWhiteSpace(firstName) &&
        !string.IsNullOrWhiteSpace(surname) &&
        !string.IsNullOrWhiteSpace(cellNo) && PhoneRule.IsValid(cellNo.Trim()) &&
        !string.IsNullOrWhiteSpace(email) && EmailRule.IsValid(email.Trim());

    protected override async Task OnInitializedAsync()
    {
        var prefsLoad = AppData.GetAsync<List<NotificationPreferenceDto>>("api/notifications/preferences");
        user = await AppData.GetAsync<UserDto>("api/users/me");
        Reset();
        prefs = await prefsLoad ?? [];
    }

    private List<NotificationPreferenceDto>? prefs;
    private bool savingPref;

    private async Task SetPref(NotificationPreferenceDto pref, bool enabled)
    {
        savingPref = true;
        var updated = pref with { Enabled = enabled };
        var ok = await AppData.SendAsync(HttpMethod.Put, "api/notifications/preferences",
            new UpdateNotificationPreferencesRequest { Preferences = [updated] });
        savingPref = false;
        if (ok) prefs![prefs.IndexOf(pref)] = updated;
    }

    private void Reset()
    {
        if (user is null) return;
        (firstName, surname, cellNo, email) = (user.FirstName, user.Surname, user.CellNo, user.Email);
    }

    // The link goes to the address saved on the account, and lands on /set-password.
    private async Task SendPasswordLink()
    {
        sendingLink = true;
        var sent = await AppData.SendAsync(HttpMethod.Post, "api/users/me/password-link");
        sendingLink = false;
        if (sent) Snackbar.Add($"We've emailed a link to {user!.Email} to change your password.", Severity.Success);
    }

    private async Task Save()
    {
        saving = true;
        var saved = await AppData.UpdateProfileAsync(new UpdateUserRequest
        {
            FirstName = firstName.Trim(),
            Surname = surname.Trim(),
            CellNo = cellNo.Trim(),
            Email = email.Trim(),
        });
        saving = false;
        if (saved is null) return; // AppData already showed the error
        user = saved;
        Reset();
        Snackbar.Add("Profile updated.", Severity.Success);
    }
}
