@page "/profile"
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@inject AppDataService AppData
@inject ISnackbar Snackbar

<PageTitle>My Profile</PageTitle>

@* =====================================================================
   STYLE BLOCK
   Same DRPS palette-as-CSS-variables approach as Notifications.razor,
   scoped under .drps-profile so it doesn't leak into MudBlazor's theme.
   ===================================================================== *@
<style>
    .drps-profile {
        --drps-navy-900: #12271F;
        --drps-blue-600: #2F5C4C;
        --drps-bg: #F5F3EC;
        --drps-surface: #FFFFFF;
        --drps-text-muted: #75806F;
        --drps-shadow: rgba(11, 22, 38, 0.06);
        background: var(--drps-bg);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .drps-profile-header {
        background: linear-gradient(135deg, var(--drps-navy-900) 0%, var(--drps-blue-600) 100%);
        border-radius: 16px;
        padding: 20px 24px;
        color: white;
        margin-bottom: 20px;
    }

    .drps-profile-header .drps-subtitle {
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.85rem;
        margin-top: 4px;
    }

    .drps-card {
        background: var(--drps-surface);
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 2px 10px var(--drps-shadow);
    }

    .drps-profile-muted {
        color: var(--drps-text-muted);
        font-size: 0.85rem;
    }

    .page.dark-mode .drps-profile {
        --drps-bg: #0B1B21;
        --drps-surface: #1E362B;
        --drps-text-muted: #93A69A;
        --drps-shadow: rgba(0, 0, 0, 0.35);
    }
</style>

<div class="drps-profile">
    <MudContainer MaxWidth="MaxWidth.Small" Class="pt-6">

        <div class="drps-profile-header">
            <MudText Typo="Typo.h6" Style="font-weight:600;">My Profile</MudText>
            <div class="drps-subtitle">Update the details other staff see and contact you on.</div>
        </div>

        <div class="drps-card">
            @if (user is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudTextField T="string" @bind-Value="firstName" Label="First Name" Required="true" RequiredError="Enter a first name." Variant="Variant.Outlined" MaxLength="100" Immediate="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="surname" Label="Surname" Required="true" RequiredError="Enter a surname." Variant="Variant.Outlined" MaxLength="100" Immediate="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="cellNo" Label="Cell Number" Required="true" RequiredError="Enter a cell number." Validation="@PhoneRule" InputType="InputType.Telephone" Variant="Variant.Outlined" MaxLength="20" Immediate="true" Class="mb-3" />

                @* Email is the sign-in name and role is an admin's call (SM-03), so both are read-only here. *@
                <MudTextField T="string" Value="@user.Email" Label="Email Address" Variant="Variant.Outlined" ReadOnly="true" Disabled="true" Class="mb-3" />
                <MudTextField T="string" Value="@user.Role" Label="Role" Variant="Variant.Outlined" ReadOnly="true" Disabled="true" Class="mb-2" />
                <div class="drps-profile-muted mb-4">To change your email or role, ask an administrator.</div>

                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@(!CanSave)">
                        @(saving ? "Saving..." : "Save Changes")
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="Reset" Disabled="@(saving || !IsDirty)">Discard</MudButton>
                </div>
            }
        </div>
    </MudContainer>
</div>

@code {
    private UserDto? user;
    private string firstName = "", surname = "", cellNo = "";
    private bool saving;

    // The same rule UpdateUserRequest applies server-side, so the message shows before Save.
    private static readonly PhoneAttribute PhoneRule = new() { ErrorMessage = "Enter a valid phone number, e.g. 082 123 4567." };

    private bool IsDirty =>
        user is not null && (firstName.Trim() != user.FirstName || surname.Trim() != user.Surname || cellNo.Trim() != user.CellNo);

    private bool CanSave =>
        !saving && IsDirty &&
        !string.IsNullOrWhiteSpace(firstName) &&
        !string.IsNullOrWhiteSpace(surname) &&
        !string.IsNullOrWhiteSpace(cellNo) && PhoneRule.IsValid(cellNo.Trim());

    protected override async Task OnInitializedAsync()
    {
        user = await AppData.GetAsync<UserDto>("api/users/me");
        Reset();
    }

    private void Reset()
    {
        if (user is null) return;
        (firstName, surname, cellNo) = (user.FirstName, user.Surname, user.CellNo);
    }

    private async Task Save()
    {
        saving = true;
        var saved = await AppData.UpdateProfileAsync(new UpdateUserRequest
        {
            FirstName = firstName.Trim(),
            Surname = surname.Trim(),
            CellNo = cellNo.Trim(),
        });
        saving = false;
        if (saved is null) return; // AppData already showed the error
        user = saved;
        Reset();
        Snackbar.Add("Profile updated.", Severity.Success);
    }
}
