@page "/forgot-password"
@using MudBlazor
@using QULOOBUL__MOE_MIENEEN_Shared.Auth
@inject AppDataService AppData

<PageTitle>Forgot Password</PageTitle>

@* Opened signed out, MainLayout renders it inside the login card. The admins get a notification
   naming who asked, and hand over a temporary password. *@

@if (sent)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">
        Request sent. The system admin will contact you with a temporary password.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-3">Tell the system admin who you are, and they'll send you a temporary password.</MudText>

    <MudTextField @bind-Value="firstName" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                  MaxLength="100" Immediate="true" Class="mb-3" />
    <MudTextField @bind-Value="surname" Label="Surname" Variant="Variant.Outlined" Margin="Margin.Dense"
                  MaxLength="100" Immediate="true" Class="mb-3" />
    <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                  InputType="InputType.Email" MaxLength="256" Immediate="true" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
               Disabled="@(!CanSubmit)" OnClick="Submit">
        @(sending ? "Sending..." : "Send Request")
    </MudButton>
}
<MudLink Href="" Typo="Typo.caption" Class="d-block mt-3">Back to sign in</MudLink>

@code {
    private string firstName = "", surname = "", email = "";
    private bool sending, sent;

    private bool CanSubmit => !sending && !string.IsNullOrWhiteSpace(firstName)
        && !string.IsNullOrWhiteSpace(surname) && !string.IsNullOrWhiteSpace(email);

    private async Task Submit()
    {
        sending = true;
        sent = await AppData.SendAsync(HttpMethod.Post, "api/auth/forgot-password",
            new ForgotPasswordRequest { FirstName = firstName, Surname = surname, Email = email });
        sending = false; // on failure AppData already showed the error
    }
}
