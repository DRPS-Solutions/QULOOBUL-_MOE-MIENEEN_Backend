@page "/set-password"
@using MudBlazor
@using QULOOBUL__MOE_MIENEEN_Shared.Auth
@inject AppDataService AppData
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Set Password</PageTitle>

@* Landing page for the emailed activation / reset / change-password link (SM-03 setPassword).
   Opened signed out, MainLayout renders it inside the login card. *@

@if (string.IsNullOrEmpty(Token))
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">This link is missing its token. Use the full link from your email.</MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-3">Choose a new password: at least 8 characters, with a letter and a digit.</MudText>

    <MudTextField T="string" @bind-Value="password" Label="New Password" InputType="@(showNew ? InputType.Text : InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@Icon(showNew)" OnAdornmentClick="() => showNew = !showNew" AdornmentAriaLabel="@(showNew ? "Hide password" : "Show password")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="128" Immediate="true"
                  Validation="@(new Func<string, string?>(PasswordError))" Class="mb-3" />
    <MudTextField T="string" @bind-Value="confirm" Label="Confirm Password" InputType="@(showConfirm ? InputType.Text : InputType.Password)" Adornment="Adornment.End" AdornmentIcon="@Icon(showConfirm)" OnAdornmentClick="() => showConfirm = !showConfirm" AdornmentAriaLabel="@(showConfirm ? "Hide password" : "Show password")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="128" Immediate="true"
                  Validation="@(new Func<string, string?>(ConfirmError))" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
               Disabled="@(!CanSubmit)" OnClick="Submit">
        @(saving ? "Saving..." : "Set Password")
    </MudButton>
}

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string password = "", confirm = "";
    private bool saving;
    private bool showNew, showConfirm; // each field has its own toggle
    private static string Icon(bool shown) => shown ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    // Mirrors AuthService.SetPasswordAsync's policy so the message shows before submitting.
    private static string? PasswordError(string p) =>
        p.Length < 8 || !p.Any(char.IsLetter) || !p.Any(char.IsDigit)
            ? "At least 8 characters, with a letter and a digit." : null;

    private string? ConfirmError(string c) => c != password ? "Passwords do not match." : null;

    private bool CanSubmit => !saving && PasswordError(password) is null && confirm == password;

    private async Task Submit()
    {
        saving = true;
        var ok = await AppData.SendAsync(HttpMethod.Post, "api/auth/set-password",
            new SetPasswordRequest { Token = Token!, Password = password });
        saving = false;
        if (!ok) return; // AppData already showed the error (expired / used link)
        Snackbar.Add("Password set. Sign in with your new password.", Severity.Success);
        Nav.NavigateTo("");
    }
}
