@* Shows a freshly issued temporary password once (test plan A3/U4). The copy goes through JS interop:
   the static site's CSP blocks inline onclick handlers. Opened with BackdropClick off so a stray
   click can't lose the password. *@
@using MudBlazor
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudText>Temporary password for @FullName:</MudText>
        <div style="display:flex; align-items:center; gap:12px; margin:12px 0;">
            <code style="font-size:1.1rem; user-select:all;">@Password</code>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Copy" Disabled="copying"
                       Color="@(copied ? Color.Success : Color.Primary)"
                       StartIcon="@(copied ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)">@copyLabel</MudButton>
            <span role="status" aria-live="polite" style="position:absolute; left:-9999px;">@(copied ? "Copied to clipboard" : "")</span>
        </div>
        <MudAlert Severity="Severity.Warning" Dense="true">
            This password can't be shown again once you close this box. Copy it or write it down first.
        </MudAlert>
        <MudText Class="mt-3">Give it to them directly. They must choose a new password when they next sign in.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string FullName { get; set; } = string.Empty;
    [Parameter] public string Password { get; set; } = string.Empty;

    private string copyLabel = "Copy";
    private bool copying, copied;

    // Feedback resets after 2s so pressing Copy again visibly confirms again.
    private async Task Copy()
    {
        copying = true;
        try
        {
            // Reference: MDN Web Docs, "Clipboard: writeText() method." Accessed: Oct. 04, 2026. [Online]. Available: https://developer.mozilla.org/en-US/docs/Web/API/Clipboard/writeText
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            (copied, copyLabel) = (true, "Copied!");
        }
        catch (JSException)
        {
            copyLabel = "Copy failed - select it instead";
        }
        copying = false;
        if (!copied) return; // keep the failure hint up
        StateHasChanged();
        await Task.Delay(2000);
        (copied, copyLabel) = (false, "Copy");
    }
}
