@* Shows a freshly issued temporary password once (test plan A3/U4). The copy goes through JS interop:
   the static site's CSP blocks inline onclick handlers. Opened with BackdropClick off so a stray
   click can't lose the password. *@
@using MudBlazor
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudText>Temporary password for @FullName:</MudText>
        <div style="display:flex; align-items:center; gap:12px; margin:12px 0;">
            <code style="font-size:1.1rem; user-select:all;">@Password</code>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="Copy">@copyLabel</MudButton>
        </div>
        <MudAlert Severity="Severity.Warning" Dense="true">
            This password can't be shown again once you close this box. Copy it or write it down first.
        </MudAlert>
        <MudText Class="mt-3">Give it to them directly. They must choose a new password when they next sign in.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string FullName { get; set; } = string.Empty;
    [Parameter] public string Password { get; set; } = string.Empty;

    private string copyLabel = "Copy";

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            copyLabel = "Copied";
        }
        catch (JSException)
        {
            copyLabel = "Copy failed - select it instead";
        }
    }
}
