<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette copied 1:1 from the Android port's ui/theme/Color.kt, which in
         turn came from the Blazor prototype's MudTheme plus its drps CSS vars. -->

    <!-- Light -->
    <Color x:Key="Primary">#3C7A63</Color>
    <Color x:Key="Secondary">#2F5C4C</Color>
    <Color x:Key="Info">#2A5CD1</Color>
    <Color x:Key="AppBar">#12271F</Color>
    <Color x:Key="Background">#F5F3EC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="TextMuted">#75806F</Color>
    <Color x:Key="BorderSoft">#E7E4D8</Color>
    <Color x:Key="TextPrimary">#1C3D32</Color>

    <!-- Dark -->
    <Color x:Key="PrimaryDark">#6FA98C</Color>
    <Color x:Key="SecondaryDark">#3C7A63</Color>
    <Color x:Key="InfoDark">#5B84D6</Color>
    <Color x:Key="BackgroundDark">#0B1B21</Color>
    <Color x:Key="SurfaceDark">#1E362B</Color>
    <Color x:Key="TextPrimaryDark">#E9F0EA</Color>
    <Color x:Key="TextMutedDark">#93A69A</Color>
    <Color x:Key="BorderSoftDark">#2E4A3B</Color>

    <!-- Shared accents (gradients, priorities, statuses) -->
    <Color x:Key="NavyGradientStart">#12271F</Color>
    <Color x:Key="NavyGradientEnd">#2F5C4C</Color>

    <Color x:Key="PriorityHigh">#E0435C</Color>
    <Color x:Key="PriorityMedium">#B9862E</Color>
    <Color x:Key="PriorityLow">#3C7A63</Color>

    <Color x:Key="TintGreen">#E7F3EB</Color>
    <Color x:Key="TintGreenBorder">#A9CDB8</Color>
    <Color x:Key="TintBlue">#EAF2ED</Color>
    <Color x:Key="TintAmber">#F6EBD3</Color>
    <Color x:Key="TintRed">#FCEEF0</Color>

    <Color x:Key="AccentBlue">#2A5CD1</Color>
    <Color x:Key="TintAccentBlue">#EEF2FC</Color>

    <Color x:Key="StatusPending">#B9862E</Color>
    <Color x:Key="StatusApproved">#2E9E5B</Color>
    <Color x:Key="StatusDenied">#E0435C</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />

</ResourceDictionary>
