<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Frontend_Mobile.Pages.EventsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Frontend_Mobile.Models"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    Title="Event Planning">

    <!-- Events.razor. This is a phone layout, so the roster and the
         detail/edit panel are stacked in one scrolling column rather than the
         original's two-column md=5/7 grid, but the state machine (roster
         selection vs. create vs. edit vs. empty) is unchanged. -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Style="{StaticResource HeaderBanner}">
                <Label Text="Event &amp; Project Planning" Style="{StaticResource BannerTitle}" />
            </Border>

            <!-- Roster -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <Label Text="&#x1F4C5; All Events" Style="{StaticResource TitleMedium}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ New" Clicked="OnNewEvent" FontSize="12" Padding="14,8" MinimumHeightRequest="36" />
                    </Grid>

                    <Label x:Name="NoEventsLabel"
                           Text="No events scheduled yet."
                           Style="{StaticResource Muted}"
                           Margin="0,20" />

                    <VerticalStackLayout x:Name="RosterList" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:EventModel">
                                <Border BackgroundColor="{StaticResource TintBlue}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="12,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEventSelected" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />
                                        <Label FontSize="11" TextColor="{StaticResource TextMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="&#x1F4C5; " />
                                                    <Span Text="{Binding DateTimeLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="11" TextColor="{StaticResource TextMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="&#x1F4CD; " />
                                                    <Span Text="{Binding LocationLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Detail / form / empty panel -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>

                    <!-- Empty state -->
                    <VerticalStackLayout x:Name="EmptyPanel" Spacing="10" Padding="0,50" HorizontalOptions="Center">
                        <Label Text="&#x1F5D3;" FontSize="32" HorizontalOptions="Center" Opacity="0.5" />
                        <Label Text="Select an event above to view its details,&#10;or tap &quot;New&quot; to plan one."
                               Style="{StaticResource Muted}"
                               FontSize="14"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Detail -->
                    <VerticalStackLayout x:Name="DetailPanel" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="DetailTitle" Style="{StaticResource TitleLarge}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Edit" Clicked="OnEditEvent"
                                    Style="{StaticResource OutlineButton}" FontSize="12" Padding="14,8" MinimumHeightRequest="36" />
                        </Grid>

                        <VerticalStackLayout Spacing="4" Margin="0,8,0,14">
                            <Label x:Name="DetailDate" Style="{StaticResource Muted}" />
                            <Label x:Name="DetailLocation" Style="{StaticResource Muted}" />
                            <Label x:Name="DetailCoordinator" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="DescriptionSection">
                            <Label Text="DESCRIPTION" Style="{StaticResource SectionLabel}" />
                            <Label x:Name="DetailDescription" FontSize="14" />
                        </VerticalStackLayout>

                        <Label Text="BUDGET &amp; CAPACITY" Style="{StaticResource SectionLabel}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0">
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <VerticalStackLayout Grid.Column="1" Padding="12">
                                        <Label x:Name="DetailBudget" Style="{StaticResource TitleMedium}" />
                                        <Label Text="Estimated Budget" Style="{StaticResource LabelSmall}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0">
                                <Grid ColumnDefinitions="4,*">
                                    <BoxView Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <VerticalStackLayout Grid.Column="1" Padding="12">
                                        <Label x:Name="DetailCapacity" Style="{StaticResource TitleMedium}" />
                                        <Label Text="Estimated Capacity" Style="{StaticResource LabelSmall}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <Label x:Name="StaffSectionLabel" Style="{StaticResource SectionLabel}" />
                        <Label x:Name="NoStaffLabel" Text="No staff assigned yet." Style="{StaticResource Muted}" />
                        <FlexLayout x:Name="StaffTags" Wrap="Wrap" Direction="Row">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Border BackgroundColor="{StaticResource TintBlue}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12,5"
                                            Margin="0,0,8,8">
                                        <Label Text="{Binding .}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Label Text="REQUIRED RESOURCES" Style="{StaticResource SectionLabel}" />
                        <Label x:Name="NoResourcesLabel" Text="No resources listed yet." Style="{StaticResource Muted}" />
                        <FlexLayout x:Name="ResourceTags" Wrap="Wrap" Direction="Row">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Border BackgroundColor="{StaticResource TintBlue}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12,5"
                                            Margin="0,0,8,8">
                                        <Label Text="{Binding .}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Create / edit form -->
                    <VerticalStackLayout x:Name="FormPanel" IsVisible="False" Spacing="12">

                        <Label x:Name="FormHeading" Style="{StaticResource TitleMedium}" />

                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="TitleEntry" Placeholder="Event Title" TextChanged="OnFormChanged" />
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Editor x:Name="DescriptionEditor" Placeholder="Description" HeightRequest="90" />
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="LocationEntry" Placeholder="Location" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout>
                                <Label Text="Date" Style="{StaticResource LabelSmall}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <DatePicker x:Name="DateField" Format="dd MMM yyyy" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Time" Style="{StaticResource LabelSmall}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <TimePicker x:Name="TimeField" Format="h:mm tt" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout>
                            <Label Text="Lead Coordinator" Style="{StaticResource LabelSmall}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Picker x:Name="CoordinatorPicker" Title="Lead Coordinator" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <VerticalStackLayout>
                                <Label Text="Estimated Budget (R)" Style="{StaticResource LabelSmall}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry x:Name="BudgetEntry" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Estimated Capacity" Style="{StaticResource LabelSmall}" />
                                <Border Style="{StaticResource FieldBox}">
                                    <Entry x:Name="CapacityEntry" Keyboard="Numeric" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="STAFF HELPING" Style="{StaticResource SectionLabel}" />
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8">
                            <VerticalStackLayout x:Name="StaffPickList">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:StaffPick">
                                        <HorizontalStackLayout Spacing="4">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                            <Label Text="{Binding Name}" FontSize="12" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="REQUIRED RESOURCES" Style="{StaticResource SectionLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource FieldBox}">
                                <Entry x:Name="ResourceEntry" Placeholder="e.g. Projector, 6 folding tables" />
                            </Border>
                            <Button Grid.Column="1" Text="Add" Clicked="OnAddResource"
                                    Style="{StaticResource OutlineButton}" FontSize="12" Padding="16,8" MinimumHeightRequest="40" />
                        </Grid>

                        <Label x:Name="NoFormResourcesLabel" Text="No resources added yet." Style="{StaticResource Muted}" />
                        <FlexLayout x:Name="FormResourceTags" Wrap="Wrap" Direction="Row">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Border BackgroundColor="{StaticResource TintBlue}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12,2,2,2"
                                            Margin="0,0,8,8">
                                        <HorizontalStackLayout Spacing="2">
                                            <Label Text="{Binding .}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center" />
                                            <Button Text="&#x00D7;"
                                                    Clicked="OnRemoveResource"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource TextMuted}"
                                                    FontSize="14"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    MinimumHeightRequest="26"
                                                    Padding="0"
                                                    CornerRadius="13" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <HorizontalStackLayout Spacing="10">
                            <Button x:Name="SaveButton" Clicked="OnSave" IsEnabled="False" />
                            <Button Text="Cancel" Clicked="OnCancelForm" Style="{StaticResource OutlineButton}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
