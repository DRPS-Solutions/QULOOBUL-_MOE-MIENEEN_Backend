<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Frontend_Mobile.Pages.UserManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Frontend_Mobile.Models"
    Title="Users">

    <!-- UserManagement.razor - roster and selected user detail, create user form. -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Border Style="{StaticResource HeaderBanner}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="User Management" Style="{StaticResource BannerTitle}" />
                    <Label Text="View the roster and manage staff accounts" Style="{StaticResource BannerSubtitle}" />
                </VerticalStackLayout>
            </Border>

            <!-- ROSTER and DETAIL VIEW -->
            <VerticalStackLayout x:Name="RosterSection" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Employees" Style="{StaticResource TitleMedium}" />
                            <Button Grid.Column="1" Text="New User" Clicked="OnNewUser" />
                        </Grid>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="SearchEntry" Placeholder="Search name, role or email" TextChanged="OnSearchTextChanged" />
                        </Border>

                        <ActivityIndicator x:Name="RosterLoadingSpinner" IsRunning="True" />
                        <Label x:Name="EmptyRosterLabel" Text="No employees match" Style="{StaticResource Muted}" IsVisible="False" />

                        <VerticalStackLayout x:Name="RosterList" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UserRow">
                                    <Border Style="{StaticResource OutlinedRow}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnUserTapped" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="13" />
                                            <Label Text="{Binding Role}" Style="{StaticResource LabelSmall}" />
                                            <Label Text="{Binding WorkloadLabel}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Selected Employee -->
                <VerticalStackLayout x:Name="DetailPanel" Spacing="12" IsVisible="False">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="DetailNameLabel" Style="{StaticResource TitleLarge}" />
                            <Label x:Name="DetailRoleLabel" Style="{StaticResource Muted}" />
                            <Label x:Name="DetailEmailLabel" Style="{StaticResource Muted}" />
                            <Label x:Name="DetailStatusLabel" Style="{StaticResource LabelSmall}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Style="{StaticResource OutlinedRow}">
                            <VerticalStackLayout>
                                <Label x:Name="CompletedCountLabel" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Completed" Style="{StaticResource LabelSmall}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource OutlinedRow}">
                            <VerticalStackLayout>
                                <Label x:Name="PendingCountLabel" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Pending" Style="{StaticResource LabelSmall}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource OutlinedRow}">
                            <VerticalStackLayout>
                                <Label x:Name="CompletionRateLabel" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Completion" Style="{StaticResource LabelSmall}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Completed Tasks" Style="{StaticResource TitleMedium}" />
                            <Label x:Name="EmptyCompletedLabel" Text="Nothing completed yet" Style="{StaticResource Muted}" IsVisible="False" />
                            <VerticalStackLayout x:Name="CompletedTaskList" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <Border Style="{StaticResource OutlinedRow}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding MetaLabel}" Style="{StaticResource LabelSmall}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Still to do" Style="{StaticResource TitleMedium}" />
                            <Label x:Name="EmptyPendingLabel" Text="All caught up" Style="{StaticResource Muted}" IsVisible="False" />
                            <VerticalStackLayout x:Name="PendingTaskList" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <Border Style="{StaticResource OutlinedRow}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding MetaLabel}" Style="{StaticResource LabelSmall}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Admin Actions -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Account actions" Style="{StaticResource TitleMedium}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <Button x:Name="DeactivateButton" Text="Deactivate" Style="{StaticResource OutlineButton}" Clicked="OnDeactivate" />
                                <Button x:Name="ReactivateButton" Grid.Column="1" Text="Reactivate" Style="{StaticResource OutlineButton}" Clicked="OnReactivate" IsVisible="False" />
                                <Button x:Name="ChangeRoleButton" Grid.Column="1" Text="Change Role" Style="{StaticResource OutlineButton}" Clicked="OnChangeRole" />
                                <Button x:Name="ResetPasswordButton" Grid.Row="1" Text="Reset Password" Style="{StaticResource OutlineButton}" Clicked="OnResetPassword" />
                                <Button Grid.Row="1" Grid.Column="1" Text="Anonymise" Style="{StaticResource OutlineButton}" Clicked="OnAnonymise" />
                                <Button x:Name="DeleteButton" Grid.Row="2" Grid.ColumnSpan="2" Text="Delete User" BackgroundColor="#E0435C" TextColor="White" Clicked="OnDelete" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- CREATE USER VIEW -->
            <VerticalStackLayout x:Name="CreateSection" Spacing="12" IsVisible="False">
                <Button Text="&#x2190; Back" Style="{StaticResource OutlineButton}" Clicked="OnBackToRoster" HorizontalOptions="Start" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Create new account" Style="{StaticResource TitleMedium}" />

                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="FirstNameEntry" Placeholder="First Name" TextChanged="OnFormChanged" />
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="SurnameEntry" Placeholder="Surname" TextChanged="OnFormChanged" />
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="EmailEntry" Placeholder="Email Address" Keyboard="Email" TextChanged="OnFormChanged" />
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry x:Name="CellEntry" Placeholder="Cell Number" Keyboard="Telephone" TextChanged="OnFormChanged" />
                        </Border>

                        <Label Text="System Role" Style="{StaticResource LabelSmall}" />
                        <Border Style="{StaticResource FieldBox}">
                            <Picker x:Name="RolePicker" Title="Select a role" SelectedIndexChanged="OnFormChanged" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="SaveUserButton" Text="Save User" Clicked="OnSaveUser" IsEnabled="False" />
                            <Button Grid.Column="1" Text="Cancel" Style="{StaticResource OutlineButton}" Clicked="OnBackToRoster" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>