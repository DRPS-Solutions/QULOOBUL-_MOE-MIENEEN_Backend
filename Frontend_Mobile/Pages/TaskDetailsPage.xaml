<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Frontend_Mobile.Pages.TaskDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Frontend_Mobile.Models"
    Title="Task Details">

    <!-- View of a tasks comments section. Task comments can be opened
    by a task card tap or a task notification's deep link. The tasks comments
    are Read-Only and editing/reassigning stays on the CreateTaskPage form. -->

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label x:Name="TitleLabel" Style="{StaticResource TitleLarge}" />
            <Label x:Name="MetaLabel" Style="{StaticResource Muted}" />
            <Label x:Name="DescriptionLabel" Style="{StaticResource Muted}" />

            <!-- Status (SM-01, test plan T3): the web board's columns as a picker. The API refuses
                 a skipped step (e.g. To Do straight to Done) and the picker snaps back. -->
            <Label Text="Status" Style="{StaticResource LabelSmall}" Margin="0,6,0,0" />
            <Border Style="{StaticResource FieldBox}">
                <Picker x:Name="StatusPicker" SelectedIndexChanged="OnStatusChanged" />
            </Border>

            <!-- Percent complete (T4): only while In Progress; Done sets 100 server-side. -->
            <VerticalStackLayout x:Name="ProgressSection" Spacing="2">
                <Label x:Name="ProgressLabel" Style="{StaticResource LabelSmall}" />
                <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100"
                        ValueChanged="OnProgressSliding" DragCompleted="OnProgressReleased" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSoft}, 
                Dark={StaticResource BorderSoftDark}}" Margin="0,6" />

            <Label x:Name="CommentsHeader" Style="{StaticResource TitleMedium}" />
            <ActivityIndicator x:Name="LoadingSpinner" IsRunning="True" />
            <Label x:Name="EmptyCommentsLabel" Text="No Comments yet" Style="{StaticResource Muted}" IsVisible="False" />

            <VerticalStackLayout x:Name="CommentList" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TaskCommentItem">
                        <Border Style="{StaticResource OutlinedRow}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding MetaLabel}" Style="{StaticResource LabelSmall}" />
                                <Label Text="{Binding Comment}" FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                <Border Style="{StaticResource FieldBox}">
                    <Entry x:Name="CommentEntry" Placeholder="Add a comment" TextChanged="OnCommentTextChanged" />
                </Border>
                <Button x:Name="PostButton" Grid.Column="1" Text="Post" IsEnabled="False" Clicked="OnPostComment" />
            </Grid>
            <Button Text="Close" Style="{StaticResource OutlineButton}" Clicked="OnClose" Margin="0,12,0,0" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>