<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Frontend_Mobile.Pages.ComingSoonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Placeholder for the two screens the Blazor prototype still has that
         neither port has picked up yet: Meetings and User Management. They
         stay in the drawer under the same role gating so the navigation shape
         is already in place. -->

    <VerticalStackLayout Padding="32" Spacing="4" VerticalOptions="Center">
        <Label Text="&#x1F6A7;"
               FontSize="28"
               HorizontalOptions="Center" />
        <Label x:Name="TitleLabel"
               Style="{StaticResource TitleMedium}"
               HorizontalTextAlignment="Center"
               Margin="0,12,0,0" />
        <Label Text="Not built yet in this .NET MAUI port - coming in a future pass."
               Style="{StaticResource Muted}"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>

</ContentPage>
